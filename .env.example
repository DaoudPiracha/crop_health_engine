# Copy this to .env and fill in values for your environment.
# Local development defaults are shown — override for deployment.

CROP=shahmeer
SEASON=kharif
ASSET_DIR=/path/to/your/assets

# URL of the deployed Express backend (no trailing slash)
BACKEND_URL=http://localhost:3003

# Set to true in production to download assets from the backend's /api/assets proxy
# (backend reads from Supabase Storage). Leave false for local dev.
USE_REMOTE_ASSETS=false
